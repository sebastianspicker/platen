{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf.local/contracts/prepress-artifact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "sourceDigest", "artifact", "receipt", "authoritative", "limitations"],
  "properties": {
    "kind": { "enum": ["icc-cmyk-artifact", "imposition-artifact"] },
    "schemaVersion": { "const": 1 },
    "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["id", "documentId", "displayName", "mediaType", "size", "sha256", "operation", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "documentId": { "type": "string" },
        "displayName": { "type": "string" },
        "mediaType": { "const": "application/pdf" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "operation": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "profile": { "type": "object" },
    "recipe": { "type": "object" },
    "layout": { "type": "object" },
    "receipt": { "type": "object" },
    "authoritative": { "const": false },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "oneOf": [
    { "properties": { "kind": { "const": "icc-cmyk-artifact" } }, "required": ["profile", "recipe"] },
    { "properties": { "kind": { "const": "imposition-artifact" } }, "required": ["layout"] }
  ]
}
