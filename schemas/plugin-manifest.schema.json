{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pdf.local/contracts/plugin-manifest.schema.json",
  "type":"object",
  "additionalProperties":false,
  "title":"Extension planning metadata",
  "description":"Non-executable planning records. They cannot declare code, runtime, permissions, dependencies, or payload files.",
  "required":["id","title","version","status","description","capabilityIds"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
    "title":{"type":"string","minLength":1},
    "version":{"type":"string","pattern":"^0\\.0\\.0-template$"},
    "status":{"const":"planned"},
    "description":{"type":"string","minLength":1},
    "capabilityIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]*(?:[.][a-z][a-z0-9-]*)+$"}}
  }
}
