{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf.local/contracts/ocr-batch.schema.json",
  "title": "Bounded local sequential OCR batch manifest",
  "description": "Source-bound result manifest returned by POST /api/ocr/batch. Artifact bytes remain behind authenticated local artifact handles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "status", "requests", "evidence", "limitations"],
  "properties": {
    "kind": {"const": "ocr-batch-manifest"},
    "schemaVersion": {"const": 1},
    "status": {"enum": ["succeeded", "partial", "failed", "cancelled"]},
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"oneOf": [{"$ref": "#/$defs/completed"}, {"$ref": "#/$defs/terminal"}]}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localOnly", "sourceBound", "engines", "ordered", "sequential", "aggregatePages", "aggregateInputBytes", "aggregateOutputBytes"],
      "properties": {
        "localOnly": {"const": true},
        "sourceBound": {"const": true},
        "engines": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["Poppler", "ImageMagick", "Tesseract"]}},
        "ordered": {"const": true},
        "sequential": {"const": true},
        "aggregatePages": {"type": "integer", "minimum": 1, "maximum": 50},
        "aggregateInputBytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "aggregateOutputBytes": {"type": "integer", "minimum": 0, "maximum": 536870912}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["id", "documentId", "kind", "status"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 8},
        "documentId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "kind": {"const": "document"}
      }
    },
    "completed": {
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "documentId", "kind", "status", "output"],
          "properties": {
            "id": {"type": "integer", "minimum": 1, "maximum": 8},
            "documentId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
            "kind": {"const": "document"},
            "status": {"const": "completed"},
            "output": {"$ref": "ocr-document.schema.json"}
          }
        }
      ]
    },
    "terminal": {
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "documentId", "kind", "status", "error"],
          "properties": {
            "id": {"type": "integer", "minimum": 1, "maximum": 8},
            "documentId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
            "kind": {"const": "document"},
            "status": {"enum": ["failed", "cancelled"]},
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
                "message": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          }
        }
      ]
    }
  }
}
