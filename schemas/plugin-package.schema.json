{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf.local/contracts/plugin-package.schema.json",
  "title": "Signed local extension metadata package",
  "description": "Canonical signed JSON metadata. It intentionally has no executable entrypoint, runtime declaration, permissions, dependencies, or payload files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageVersion", "manifest", "signature"],
  "properties": {
    "packageVersion": {"const": 1},
    "manifest": {"$ref": "#/$defs/manifest"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "pluginId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.][a-z0-9-]+)+$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"},
    "capabilityId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:[.][a-z0-9-]+)+$"},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "id", "name", "version", "description", "capabilities"],
      "properties": {
        "manifestVersion": {"const": 1},
        "id": {"$ref": "#/$defs/pluginId"},
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/semver"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "capabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/capabilityId"}}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "publisherId", "keyId", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"}, "publisherId": {"$ref": "#/$defs/pluginId"},
        "keyId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
        "value": {"type": "string", "minLength": 88, "maxLength": 88, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }
    }
  }
}
