{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pdf.local/contracts/research-provenance.schema.json",
  "title":"Feature-family research provenance",
  "description":"Auditable family-level market-research provenance; it is not per-command product coverage or implementation evidence.",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","snapshotDate","evidencePurpose","notImplementationEvidence","methodology","sources","families"],
  "properties":{
    "schemaVersion":{"const":1},
    "snapshotDate":{"type":"string","format":"date"},
    "evidencePurpose":{"const":"market-research-provenance"},
    "notImplementationEvidence":{"const":true},
    "methodology":{"type":"string","minLength":40},
    "sources":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","product","url","reviewedDate"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"product":{"type":"string","minLength":2},"url":{"type":"string","pattern":"^https://"},"reviewedDate":{"type":"string","format":"date"}}}},
    "families":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["familyId","sourceIds","evidenceGranularity","locator"],"properties":{"familyId":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"sourceIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"}},"evidenceGranularity":{"const":"feature-family"},"locator":{"type":"string","minLength":20}}}}
  }
}
