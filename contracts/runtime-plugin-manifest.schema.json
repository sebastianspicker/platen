{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf.local/contracts/runtime-plugin-manifest.schema.json",
  "title": "Signed local plugin runtime manifest",
  "description": "Manifest v2 packages are verifiable but non-executable. Manifest v3 admits only a signed JavaScriptCore classic script, and still requires an external runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "version", "protocolVersion", "entry", "capabilities", "permissions", "dependencies", "activation"],
  "properties": {
    "manifestVersion": {"enum": [2, 3]}, "id": {"type": "string"}, "name": {"type": "string"}, "version": {"type": "string"}, "protocolVersion": {"const": 1}, "entry": {"type": "string"}, "capabilities": {"type": "array"}, "permissions": {"type": "array"}, "dependencies": {"type": "array"}, "activation": {"type": "string"}, "runtime": {"$ref": "#/$defs/runtime"}
  },
  "oneOf": [{"$ref": "#/$defs/manifestV2"}, {"$ref": "#/$defs/manifestV3"}],
  "$defs": {
    "commonProperties": {
      "type": "object",
      "required": ["manifestVersion", "id", "name", "version", "protocolVersion", "entry", "capabilities", "permissions", "dependencies", "activation"],
      "properties": {
    "manifestVersion": {"enum": [2, 3]},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.][a-z0-9-]+)+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"},
    "protocolVersion": {"const": 1},
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*[.](?:mjs|js)$",
      "not": {"pattern": "(^|/)[.][.](/|$)"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:[.][a-z0-9-]+)+$"}
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": {"enum": ["document.metadata", "document.read.bytes", "document.modify", "document.export", "ui.panel", "ui.toolbar", "storage.local"]},
          "reason": {"type": "string", "minLength": 8}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.][a-z0-9-]+)+$"},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
        "activation": {"enum": ["manual", "on-capability"]}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["kind", "apiVersion"],
      "properties": {"kind": {"const": "javascriptcore-classic-script"}, "apiVersion": {"const": 1}}
    },
    "manifestV2": {
      "allOf": [{"$ref": "#/$defs/commonProperties"}],
      "additionalProperties": false,
      "properties": {
        "manifestVersion": {"const": 2}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.][a-z0-9-]+)+$"}, "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"}, "protocolVersion": {"const": 1},
        "entry": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*[.]mjs$", "not": {"pattern": "(^|/)[.][.](/|$)"}},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:[.][a-z0-9-]+)+$"}},
        "permissions": {"$ref": "#/$defs/commonProperties/properties/permissions"}, "dependencies": {"$ref": "#/$defs/commonProperties/properties/dependencies"}, "activation": {"enum": ["manual", "on-capability"]}
      }
    },
    "manifestV3": {
      "allOf": [{"$ref": "#/$defs/commonProperties"}],
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": {
        "manifestVersion": {"const": 3}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.][a-z0-9-]+)+$"}, "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"}, "protocolVersion": {"const": 1},
        "entry": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*[.]js$", "not": {"pattern": "(^|/)[.][.](/|$)"}},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:[.][a-z0-9-]+)+$"}},
        "permissions": {"$ref": "#/$defs/commonProperties/properties/permissions"}, "dependencies": {"type": "array", "maxItems": 0}, "activation": {"enum": ["manual", "on-capability"]}, "runtime": {"$ref": "#/$defs/runtime"}
      }
    }
  }
}
