{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf.local/contracts/source-bound-redaction-plan.schema.json",
  "title": "Sanitized public source-bound redaction proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "profile",
    "schemaVersion",
    "status",
    "createdAtLocal",
    "sourceSha256",
    "coordinateSpace",
    "marks",
    "applicationProfile",
    "planSha256"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "type": { "const": "redaction-plan" },
    "profile": { "const": "source-bound-redaction-plan-v1" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "proposed-not-applied" },
    "createdAtLocal": { "type": "string", "format": "date-time" },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coordinateSpace": { "const": "normalized-cropbox-top-left-v1" },
    "marks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "page", "fullPage"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "page": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "fullPage": { "const": true }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "page", "region"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "page": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "region": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                  "y": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                  "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                  "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
                }
              }
            }
          }
        ]
      }
    },
    "applicationProfile": { "const": "verified-raster-burn-v2" },
    "planSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
