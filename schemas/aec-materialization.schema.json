{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf.local/contracts/aec-materialization.schema.json",
  "title": "Validated PDF-native AEC annotation artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "sourceDigest", "measurement", "artifact", "nativeReceipt", "receipt", "evidence", "limitations"],
  "properties": {
    "kind": {"const": "pdf-native-aec-measurement"}, "schemaVersion": {"const": 2},
    "sourceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "measurement": {"type": "object"}, "artifact": {"type": "object"},
    "nativeReceipt": {"type": "object"},
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "operation", "sourceSha256", "outputSha256", "measurementId", "page", "kind", "quantity", "unit", "calibrationId", "annotationCount", "annotationSubtypes", "measurementDictionaryEmbedded", "measurementDictionaryScope", "sourcePrefixPreserved", "rootPreserved", "infoPreserved", "catalogVersionRaised", "idPolicy", "pageCount"],
      "properties": {
        "schema": {"const": "platen-aec-materialization-receipt-v2"}, "version": {"const": 2}, "operation": {"const": "applyAecMeasurement"},
        "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "outputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "measurementId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "page": {"type": "integer", "minimum": 1, "maximum": 100},
        "kind": {"enum": ["distance", "perimeter", "area", "count"]}, "quantity": {"type": "number", "exclusiveMinimum": 0}, "unit": {"enum": ["m", "m2", "count"]},
        "calibrationId": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, {"type": "null"}]},
        "annotationCount": {"type": "integer", "minimum": 1, "maximum": 50}, "annotationSubtypes": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"enum": ["line", "ink", "circle"]}},
        "measurementDictionaryEmbedded": {"type": "boolean"}, "measurementDictionaryScope": {"enum": ["line-and-page-viewport", "page-viewport", null]}, "sourcePrefixPreserved": {"const": true}, "rootPreserved": {"type": "boolean"}, "infoPreserved": {"type": "boolean"}, "catalogVersionRaised": {"type": "boolean"}, "idPolicy": {"type": "string", "minLength": 1}, "pageCount": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "evidence": {"type": "object", "additionalProperties": false, "required": ["localOnly", "sourceBound", "nativeAnnotations", "helperReopened", "popplerParsed", "allPagesRendered", "sourceUnchanged"], "properties": {"localOnly": {"const": true}, "sourceBound": {"const": true}, "nativeAnnotations": {"const": true}, "helperReopened": {"const": true}, "popplerParsed": {"const": true}, "allPagesRendered": {"const": true}, "sourceUnchanged": {"const": true}}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  }
}
