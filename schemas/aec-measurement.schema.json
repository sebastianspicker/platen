{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf.local/contracts/aec-measurement.schema.json",
  "title": "Source-bound AEC measurement result",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "sourceDigest", "workspaceRevision", "measurement"],
  "properties": {
    "kind": {"const": "source-bound-aec-measurement"}, "schemaVersion": {"const": 1},
    "sourceDigest": {"$ref": "#/$defs/sha256"}, "workspaceRevision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "measurement": {"$ref": "#/$defs/measurement"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "point": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "box": {"type": "object", "additionalProperties": false, "required": ["left", "bottom", "right", "top"], "properties": {"left": {"type": "number"}, "bottom": {"type": "number"}, "right": {"type": "number"}, "top": {"type": "number"}}},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "page", "displayBox", "box", "rotation", "geometrySha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "page": {"type": "integer", "minimum": 1}, "displayBox": {"const": "crop"}, "box": {"$ref": "#/$defs/box"}, "rotation": {"enum": [0, 90, 180, 270]}, "geometrySha256": {"$ref": "#/$defs/sha256"}}
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "id", "type", "source", "calibrationId", "kind", "geometry", "result", "label", "provenanceSha256", "createdAt"],
      "properties": {
        "schemaVersion": {"const": 2}, "id": {"$ref": "#/$defs/id"}, "type": {"const": "measurement"}, "source": {"$ref": "#/$defs/source"},
        "calibrationId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "kind": {"enum": ["distance", "perimeter", "area", "count"]},
        "geometry": {"type": "object", "additionalProperties": false, "required": ["space", "points"], "properties": {"space": {"const": "pdf-user-space-v1"}, "points": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/point"}}}},
        "result": {"type": "object", "additionalProperties": false, "required": ["dimension", "siValue", "siUnit", "displayValue", "displayUnit"], "properties": {"dimension": {"enum": ["length", "area", "count"]}, "siValue": {"type": "number", "minimum": 0}, "siUnit": {"enum": ["m", "m2", "count"]}, "displayValue": {"type": "number", "minimum": 0}, "displayUnit": {"enum": ["mm", "cm", "m", "in", "ft", "mm2", "cm2", "m2", "in2", "ft2", "count"]}}},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}, "provenanceSha256": {"$ref": "#/$defs/sha256"}, "createdAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
